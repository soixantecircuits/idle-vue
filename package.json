{
  "name": "idle-vue",
  "version": "3.0.0",
  "description": "Vue 3 idle detection: store-free plugin + useIdle() composable + optional Pinia store. Powered by idle-js.",
  "keywords": [
    "activity",
    "idle",
    "pinia",
    "vue",
    "vue3"
  ],
  "bugs": {
    "url": "https://github.com/soixantecircuits/idle-vue/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/soixantecircuits/idle-vue.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./pinia": {
      "import": "./dist/pinia.mjs",
      "require": "./dist/pinia.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "idle-js": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.0",
    "pinia": "^2.2.0",
    "typescript": "^5.6.0",
    "vite-plus": "^1.4.0",
    "vue": "^3.4.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.8.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
